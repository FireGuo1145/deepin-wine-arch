pkgbase = deepin-wine-builder
	pkgdesc = 统信 Windows 应用兼容引擎（deepin-wine 打包/运行前端），Deb 包在 Arch 上的再打包
	pkgver = 4.0.2+v25
	pkgrel = 1
	url = https://www.uniontech.com/
	install = deepin-wine-builder.install
	arch = x86_64
	license = LicenseRef-proprietary-UOS
	makedepends = gcc
	makedepends = curl
	depends = glibc
	depends = gcc-libs
	depends = qt6-base
	depends = qt6-5compat
	depends = qt6-declarative
	depends = dtk6core
	depends = dtk6gui
	depends = dtk6widget
	depends = dtk6log
	depends = libarchive
	depends = yaml-cpp
	depends = vulkan-icd-loader
	depends = libx11
	depends = python
	depends = hicolor-icon-theme
	optdepends = unrar: 解包 RAR 格式的 Windows 安装包
	optdepends = cabextract: 解包 CAB 格式的安装包
	optdepends = wqy-microhei: 中文界面字体
	optdepends = fakeroot: 打包 .deb 时需要
	optdepends = dpkg: AUR —— 生成 .deb 安装包需要 dpkg-deb
	optdepends = debhelper: AUR —— 生成 Debian 打包脚手架时需要
	optdepends = xdg-utils: 设置默认 MIME 关联时需要
	optdepends = python-requests: 内置 AI 截图分析工具（appdata/tools）需要
	optdepends = python-openpyxl: 内置 yml 测试脚本需要
	provides = deepin-wine-runner
	conflicts = deepin-wine-runner
	replaces = deepin-wine-runner
	source = deepin-wine-builder.sh
	source = deepin-wine-builder.desktop
	source = deepin-wine-builder-debug.desktop
	source = com.deepin.DeepinWineBuilder.service
