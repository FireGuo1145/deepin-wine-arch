pkgname = deepin-wine10-stable
	pkgdesc = deepin-wine 10 运行时（上游 10.14deepin14，纯 wow64，无需 multilib）
	depends = glibc
	optdepends = alsa-lib: 声音输出（运行时 dlopen，缺了只是没声音）
	optdepends = libpulse: PulseAudio 后端
	optdepends = libgstreamer: 媒体播放
	optdepends = gst-plugins-base: 媒体播放
	optdepends = libgphoto2: 数码相机透传
	optdepends = pcsclite: 智能卡
	optdepends = sane: 扫描仪
	optdepends = libusb: USB 设备透传
	optdepends = ocl-icd: OpenCL
	optdepends = libcups: 打印
	optdepends = fontconfig: 字体渲染
	optdepends = freetype2: 字体渲染
	optdepends = libpng: 图像
	optdepends = libjpeg-turbo: 图像
	optdepends = gnutls: 网络加密
	optdepends = krb5: 域认证
	optdepends = vulkan-icd-loader: DXVK / VKD3D 需要
	optdepends = sdl2: 游戏手柄等
	optdepends = libv4l: 摄像头
	optdepends = libxcomposite: 窗口合成（dlopen）
	optdepends = libxcursor: 鼠标指针（dlopen）
	optdepends = libxfixes: X11 扩展（dlopen）
	optdepends = libxi: 输入设备（dlopen）
	optdepends = libxinerama: 多显示器（dlopen）
	optdepends = libxrandr: 分辨率（dlopen）
	optdepends = libxrender: 渲染（dlopen）
	optdepends = libxxf86vm: 显示模式（dlopen）
	optdepends = libxext: X11 扩展（dlopen）

