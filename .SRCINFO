pkgname = deepin-wine-extras
	pkgdesc = deepin-wine 附加组件 DXVK / VKD3D（上游 1.0.2）
	arch = any
	depends = glibc
	optdepends = vulkan-icd-loader: DXVK / VKD3D 运行需要 Vulkan 加载器
	optdepends = vulkan-radeon: AMD 显卡的 Vulkan 驱动
	optdepends = vulkan-intel: Intel 显卡的 Vulkan 驱动
	optdepends = nvidia-utils: NVIDIA 显卡的 Vulkan 驱动

pkgname = deepin-wine-helper
	pkgdesc = deepin-wine 运行辅助工具 /opt/deepinwine/tools（上游 5.4.12+v25-1）
	depends = glibc
	depends = gcc-libs
	depends = qt6-base
	depends = dtk6core
	depends = dtk6gui
	depends = dtk6widget
	depends = libx11
	depends = mesa
	depends = deepin-qt6integration
	optdepends = p7zip: 解压安装包（上游依赖 p7zip-full）
	optdepends = python-dbus: 托盘/菜单相关脚本（上游依赖 python3-dbus）
	optdepends = noto-fonts-cjk: 中文字体（上游依赖 fonts-noto-cjk）
	optdepends = xorg-xdpyinfo: 上游依赖 x11-utils

pkgname = deepin-wine-logtool
	pkgdesc = deepin-wine 日志采集工具（上游 1.0.4）
	depends = glibc
	optdepends = dconf: 读取 dconf 配置（上游依赖 dconf-cli）

pkgname = deepin-wine-builder
	pkgdesc = 统信 Windows 应用兼容引擎（上游 4.0.2+v25-1）
	install = deepin-wine-builder.install
	depends = glibc
	depends = gcc-libs
	depends = qt6-base
	depends = qt6-5compat
	depends = qt6-declarative
	depends = dtk6core
	depends = dtk6gui
	depends = dtk6widget
	depends = dtk6log
	depends = deepin-qt6integration
	depends = libarchive
	depends = yaml-cpp
	depends = vulkan-icd-loader
	depends = libx11
	depends = python
	depends = hicolor-icon-theme
	depends = deepin-wine10-stable
	depends = deepin-wine-helper
	optdepends = deepin-wine11-stable: 另一套 wine 11 运行时（可在界面里切换）
	optdepends = deepin-wine-staging: wine-staging 运行时（可在界面里切换）
	optdepends = deepin-wine-extras: DXVK / VKD3D 等附加组件与离线依赖包
	optdepends = deepin-wine-logtool: 与 builder 配套的日志采集工具
	optdepends = unrar: 解包 RAR 格式的 Windows 安装包
	optdepends = cabextract: 解包 CAB 格式的安装包
	optdepends = wqy-microhei: 中文界面字体
	optdepends = fakeroot: 打包 .deb 时需要
	optdepends = dpkg: AUR —— 生成 .deb 安装包需要 dpkg-deb
	optdepends = debhelper: AUR —— 生成 Debian 打包脚手架时需要
	optdepends = xdg-utils: 设置默认 MIME 关联时需要
	optdepends = python-requests: 内置 AI 截图分析工具（appdata/tools）需要
	optdepends = python-openpyxl: 内置 yml 测试脚本需要
	optdepends = deepin-qt6platform-plugins: 需要 dxcb 平台插件或 DDE 窗口装饰时才装
	provides = deepin-wine-runner
	conflicts = deepin-wine-runner
	replaces = deepin-wine-runner
