# Maintainer: FireGuo <fireguo@localhost>
#
# deepin-wine-helper 提供 /opt/deepinwine/tools/*（run_v4.sh、sendkeys、
# startbottle.exe、gl-wine 等），是 UOS 商店里 wine 应用包和
# deepin-wine-builder 都会用到的运行辅助脚本。
#
# 上游只发 Debian 包：这里把官方 .deb 载荷原样装到 /opt/deepinwine，
# 并把自启动项放到 /etc/xdg/autostart。

pkgname=deepin-wine-helper
pkgver=5.4.12+v25
pkgrel=1
pkgdesc='deepin-wine 运行辅助工具（/opt/deepinwine/tools，UOS 发布）'
arch=('x86_64')
url='https://www.uniontech.com/'
license=('LicenseRef-proprietary-UOS')
depends=(
  'glibc' 'gcc-libs'
  'qt6-base'
  'dtk6core' 'dtk6gui' 'dtk6widget'
  'libx11'
  'mesa'                     # libGL.so.1，gl-wine64 需要
  'deepin-qt6integration'    # 提供 chameleon 风格插件，DTK 界面缺了会崩
)
optdepends=(
  'p7zip: 解压安装包（上游依赖 p7zip-full）'
  'python-dbus: 托盘/菜单相关脚本（上游依赖 python3-dbus）'
  'noto-fonts-cjk: 中文字体（上游依赖 fonts-noto-cjk）'
  'xorg-xdpyinfo: 上游依赖 x11-utils'
)
# 不 strip：上游 ELF 带 elfsign 校验和
options=('!strip')
makedepends=('curl')

_debname='deepin-wine-helper_5.4.12+v25-1_amd64.deb'
_debsha256='34549f17c05046cbdff5d3c8257079e3b87702bec799a6ba4bdf502108906671'
_deburl="https://com-store-packages.uniontech.com/appstore-V25/pool/appstore/d/${pkgname}/${_debname}"

source=('LICENSE')
sha256sums=('f4ece7e8de81418341f6e27c097954066766eeb01f985f8f12e52caa0d807062')

prepare() {
  cd "$srcdir"
  if [[ ! -f $_debname ]]; then
    if [[ -f $startdir/$_debname ]]; then
      cp "$startdir/$_debname" .
    else
      msg2 "从 UOS 商店下载 $_debname"
      curl -fL --retry 3 --connect-timeout 20 \
           -A 'Mozilla/5.0 (X11; Linux x86_64)' \
           -e 'https://com-store-packages.uniontech.com/' \
           -o "$_debname" "$_deburl"
    fi
  fi
  echo "$_debsha256  $_debname" | sha256sum -c -
}

build() {
  cd "$srcdir"
  bsdtar -xf "$_debname" data.tar.xz
}

package() {
  cd "$srcdir"
  install -d "$pkgdir"
  bsdtar -xf data.tar.xz -C "$pkgdir" --no-same-owner --no-xattrs
  rm -rf "$pkgdir/usr/share/doc"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
