[Desktop Entry]
Type=Application
Categories=System;Utility;
Icon=deepin-wine-builder
StartupWMClass=deepin-wine-builder
StartupNotify=true
Exec=deepin-wine-builder %f
Name=UOS Windows Application Compatibility Engine
Name[zh_CN]=统信Windows应用兼容引擎
Comment=Run Windows software with deepin-wine Linux
Comment[zh_CN]=使用 deepin-wine 运行 Windows 软件
Keywords=wine;windows;exe;deepin;
MimeType=x-scheme-handler/deepinwine;application/dwb;application/x-ms-dos-executable;application/x-msi;application/x-wine-extension-msp;text/x-msdos-batch;
